{
  "name": "byapar-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Byapar (व्यापार) - Offline-First Smart Business Management Platform for Nepal MSMEs",
  "scripts": {
    "dev": "pnpm --filter @byapar/web dev",
    "dev:admin": "pnpm --filter @byapar/admin dev",
    "dev:mobile": "pnpm --filter @byapar/mobile start",
    "build": "pnpm --filter @byapar/web build",
    "build:admin": "pnpm --filter @byapar/admin build",
    "deploy:web": "npx wrangler deploy --config apps/web/wrangler.toml",
    "deploy:admin": "npx wrangler deploy --config apps/admin/wrangler.toml",
    "deploy:shortlinks": "pnpm --filter @byapar/edge-shortlinks deploy"
  },
  "pnpm": {
    "overrides": {
      "@solidjs/vite-plugin": "3.0.0-next.27"
    }
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
