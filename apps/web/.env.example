# Byapar (व्यापार) - Web Environment Variables
VITE_SUPABASE_URL=https://sovpldesvrdbmklpntrx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudflare Turnstile (Anti-Bot Auth Shield)
# Leave blank to use built-in Always-Pass test key (1x00000000000000000000AA) during dev/testing
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Cloudflare D1 + Workers Invoice Shortlinks URL
# Format: https://byapar-edge-shortlinks.<your-subdomain>.workers.dev
VITE_EDGE_SHORTLINK_URL=
