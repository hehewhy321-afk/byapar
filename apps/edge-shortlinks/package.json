{
  "name": "@byapar/edge-shortlinks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create byapar_shortlinks",
    "d1:init": "wrangler d1 execute byapar_shortlinks --local --file=./schema.sql",
    "d1:init:prod": "wrangler d1 execute byapar_shortlinks --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
